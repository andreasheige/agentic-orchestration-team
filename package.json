{
    "name": "agent-team-app",
    "version": "0.1.0",
    "description": "Multi-tenant AI agent orchestration platform with Azure OpenAI-powered specialist sub-agents",
    "private": true,
    "bin": {
        "agent-team": "./cli/agent-team.ts"
    },
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "dev": "docker compose up -d redis && nest start --watch & sleep 3 && tsx cli/agent-team.ts",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\"",
        "agent-team": "tsx cli/agent-team.ts"
    },
    "dependencies": {
        "@azure/identity": "^4.13.1",
        "@nestjs-modules/ioredis": "^2.0.2",
        "@nestjs/bull": "^10.2.3",
        "@nestjs/common": "^10.4.15",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.15",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.15",
        "bull": "^4.16.5",
        "ioredis": "^6.0.0",
        "openai": "^4.77.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@types/bull": "^4.10.0",
        "@types/express": "^5.0.0",
        "@types/node": "^22.10.0",
        "@types/passport-jwt": "^4.0.1",
        "tsx": "^4.21.0",
        "typescript": "^5.7.2"
    }
}